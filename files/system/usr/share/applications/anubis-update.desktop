[Desktop Entry]
Version=1.0
Type=Application
Name=Update System
Comment=Update rpm-ostree, Flatpaks, Brew, and firmware
Icon=anubis-update
# Opens Blackbox-terminal and runs `ujust update-all`, which handles
# rpm-ostree upgrade, flatpak update, brew upgrade, and fwupd refresh.
# Falls back to gnome-terminal, then xterm if Blackbox isn't available.
Exec=/bin/bash -c '\
    if command -v blackbox-terminal &>/dev/null; then \
        blackbox-terminal -- bash -c "ujust update-all; echo; echo Done — press Enter to close; read"; \
    elif command -v ptyxis &>/dev/null; then \
        ptyxis -- bash -c "ujust update-all; echo; echo Done — press Enter to close; read"; \
    elif command -v gnome-terminal &>/dev/null; then \
        gnome-terminal -- bash -c "ujust update-all; echo; echo Done — press Enter to close; read"; \
    else \
        xterm -e bash -c "ujust update-all; echo; echo Done — press Enter to close; read"; \
    fi'
Terminal=false
Categories=System;PackageManager;
Keywords=update;upgrade;system;packages;flatpak;brew;firmware;
StartupNotify=true
